# FreelanceOS Backend Environment Variables Example
PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.7wfd1n1.mongodb.net/freelanceos?retryWrites=true&w=majority

# REQUIRED — the server refuses to start without this. Generate a long random
# value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Optional Email Credentials
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
